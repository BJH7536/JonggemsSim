# 제출 제외 자료 (커밋 금지 — 사용자 지시)
submission.local/

# OMC 런타임 상태
.omc/

# 빌드·의존성 (향후)
node_modules/
dist/

# 비밀 값 — AETHER_API_KEY 등. 커밋되면 공개 레포라 즉시 유출이다.
# tools/aether-gen.js 는 환경변수로만 키를 받는다 (인자로 넘기면 셸 히스토리에 남는다).
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

# 반입 에셋 스테이징 — 바이너리는 라이선스 확인 전까지 커밋하지 않는다.
# 이유와 해제 절차는 Assets/README.md 참조 (public 레포 = 커밋이 곧 재배포).
Assets/**
!Assets/README.md
!Assets/*/
!Assets/*/SOURCES.md
.playwright-mcp/
